{
  "schema": "ley-reference-corpus/v1",
  "license": "CC0-1.0",
  "contract": {
    "extractor_id": "ley-html-v1",
    "analyzer_id": "ley-text-v1",
    "unicode_version": "17.0.0",
    "limits": {
      "url_key_bytes": 2048,
      "redirect_hops": 10,
      "compressed_response_bytes": 2097152,
      "decoded_response_bytes": 8388608,
      "html_parser_events": 250000,
      "html_nesting_depth": 256,
      "title_bytes": 4096,
      "combined_fields_bytes": 1048576,
      "document_tokens": 100000,
      "token_codepoints": 64,
      "phrase_tokens": 16,
      "query_bytes": 4096,
      "query_token_occurrences": 64,
      "links_per_document": 5000
    }
  },
  "limit_vectors": [
    {"limit": "url_key_bytes", "at": 2048, "at_outcome": "accept_key", "over": 2049, "over_outcome": "reject_url"},
    {"limit": "redirect_hops", "at": 10, "at_outcome": "continue_chain", "over": 11, "over_outcome": "reject_chain_retain_previous"},
    {"limit": "compressed_response_bytes", "at": 2097152, "at_outcome": "accept_body", "over": 2097153, "over_outcome": "reject_response_retain_previous"},
    {"limit": "decoded_response_bytes", "at": 8388608, "at_outcome": "accept_body", "over": 8388609, "over_outcome": "reject_response_retain_previous"},
    {"limit": "html_parser_events", "at": 250000, "at_outcome": "continue_parse", "over": 250001, "over_outcome": "reject_document_retain_previous"},
    {"limit": "html_nesting_depth", "at": 256, "at_outcome": "continue_parse", "over": 257, "over_outcome": "reject_document_retain_previous"},
    {"limit": "title_bytes", "at": 4096, "at_outcome": "accept_field", "over": 4097, "over_outcome": "reject_document_retain_previous"},
    {"limit": "combined_fields_bytes", "at": 1048576, "at_outcome": "accept_fields", "over": 1048577, "over_outcome": "reject_document_retain_previous"},
    {"limit": "document_tokens", "at": 100000, "at_outcome": "accept_document", "over": 100001, "over_outcome": "reject_document_retain_previous"},
    {"limit": "token_codepoints", "at": 64, "at_outcome": "accept_token", "over": 65, "over_outcome": "TokenTooLong"},
    {"limit": "phrase_tokens", "at": 16, "at_outcome": "accept_phrase", "over": 17, "over_outcome": "PhraseTooLong"},
    {"limit": "query_bytes", "at": 4096, "at_outcome": "pass_byte_limit", "over": 4097, "over_outcome": "QueryTooLong"},
    {"limit": "query_token_occurrences", "at": 64, "at_outcome": "accept_query", "over": 65, "over_outcome": "TooManyTerms"},
    {"limit": "links_per_document", "at": 5000, "at_outcome": "accept_links", "over": 5001, "over_outcome": "keep_first_5000"}
  ],
  "url_vectors": [
    {
      "input": "HTTP://Example.TEST:80/catalog/./manual/../search?tag=x&tag=y#chapter",
      "expected": "http://example.test/catalog/search?tag=x&tag=y",
      "reason": "scheme, host, default port, dot segments, and fragment"
    },
    {
      "input": "https://example.test/%2e%2e/a/%7euser",
      "expected": "https://example.test/a/~user",
      "reason": "encoded dot segment and unreserved escape"
    },
    {
      "input": "https://BÜCHER.example/Über?x=1#top",
      "expected": "https://xn--bcher-kva.example/%C3%9Cber?x=1",
      "reason": "IDNA host, UTF-8 path encoding, and fragment"
    },
    {
      "input": "https://example.test/a%2fb",
      "expected": "https://example.test/a%2Fb",
      "reason": "reserved slash remains encoded and escape hex is uppercase"
    },
    {
      "input": "https://example.test/a/b",
      "expected": "https://example.test/a/b",
      "reason": "literal path separator remains distinct from encoded slash"
    },
    {
      "input": "https://example.test/search?a=1&a=2&x=",
      "expected": "https://example.test/search?a=1&a=2&x=",
      "reason": "repeated query keys, order, and empty value are preserved"
    },
    {
      "input": "https://example.test/search?b=2&a=1",
      "expected": "https://example.test/search?b=2&a=1",
      "reason": "query parameter order remains significant"
    },
    {
      "input": "https://example.test/search?",
      "expected": "https://example.test/search?",
      "reason": "empty query marker is preserved"
    },
    {
      "input": "https://example.test/search?q=ley#section",
      "expected": "https://example.test/search?q=ley",
      "reason": "fragment does not participate in identity"
    },
    {
      "input": "https://example.test/search?q=ley",
      "expected": "https://example.test/search?q=ley",
      "reason": "same query without a fragment has the same URL key"
    },
    {
      "input": "https://example.test/path/",
      "expected": "https://example.test/path/",
      "reason": "trailing slash is significant"
    },
    {
      "input": "https://example.test/path",
      "expected": "https://example.test/path",
      "reason": "missing trailing slash is distinct"
    },
    {
      "input": "https://example.test:443/path",
      "expected": "https://example.test/path",
      "reason": "HTTPS default port is removed"
    },
    {
      "input": "http://example.test/path",
      "expected": "http://example.test/path",
      "reason": "HTTP remains distinct from HTTPS"
    },
    {
      "input": "https://www.example.test/path",
      "expected": "https://www.example.test/path",
      "reason": "www host prefix is preserved"
    },
    {
      "input": "https://example.test/Case",
      "expected": "https://example.test/Case",
      "reason": "path case is preserved"
    },
    {
      "input": "https://example.test/case",
      "expected": "https://example.test/case",
      "reason": "path case remains distinct"
    },
    {
      "input": "https://example.test/path?utm_source=local",
      "expected": "https://example.test/path?utm_source=local",
      "reason": "unknown tracking parameters are preserved"
    },
    {
      "input": "https://example.test/?q=%7e",
      "expected": "https://example.test/?q=~",
      "reason": "unreserved escapes are decoded in query values too"
    },
    {
      "input": "https://example.test/caf%c3%a9",
      "expected": "https://example.test/caf%C3%A9",
      "reason": "reserved/non-ASCII escapes use uppercase hex"
    },
    {
      "input": " https://example.test/trim ",
      "expected": "https://example.test/trim",
      "reason": "WHATWG parser trims surrounding ASCII spaces from URL input"
    },
    {
      "input": "https://example.test/%zz",
      "error": "malformed_percent_escape",
      "reason": "malformed percent escapes are rejected"
    },
    {
      "input": "https://@example.test/private",
      "error": "userinfo",
      "reason": "even empty userinfo syntax is rejected"
    },
    {
      "input": "ftp://example.test/file",
      "error": "unsupported_scheme",
      "reason": "only HTTP and HTTPS are accepted"
    }
  ],
  "identity_vectors": [
    {
      "kind": "redirect",
      "requested_url": "https://example.test/start",
      "effective_url": "https://example.test/final",
      "canonical_hint": "https://example.test/preferred",
      "expected_document_id": "https://example.test/start",
      "expected_effective_url": "https://example.test/final"
    },
    {
      "kind": "conflicting_canonical_hints",
      "document_ids": ["https://example.test/left", "https://example.test/right"],
      "canonical_hints": ["https://example.test/right", "https://example.test/left"],
      "expected_document_ids": ["https://example.test/left", "https://example.test/right"]
    },
    {
      "kind": "same_content_distinct_urls",
      "document_ids": ["https://example.test/tie-a", "https://example.test/tie-z"],
      "expected_same_content_fingerprint": true,
      "expected_distinct_document_ids": true
    }
  ],
  "redirect_vectors": [
    {
      "id": "relative_permanent_redirect",
      "requested_url": "https://example.test/start",
      "hops": [{"status": 301, "location": "/final"}],
      "terminal_url": "https://example.test/final",
      "expected_document_id": "https://example.test/start",
      "expected_effective_url": "https://example.test/final",
      "expected_outcome": "publish"
    },
    {
      "id": "redirect_to_unadmitted_origin",
      "requested_url": "https://example.test/start",
      "hops": [{"status": 302, "location": "https://outside.test/final"}],
      "expected_document_id": "https://example.test/start",
      "expected_outcome": "deny_target_retain_previous"
    },
    {
      "id": "redirect_loop",
      "requested_url": "https://example.test/a",
      "hops": [{"status": 302, "location": "/b"}, {"status": 301, "location": "/a"}],
      "expected_document_id": "https://example.test/a",
      "expected_outcome": "reject_loop_retain_previous"
    },
    {
      "id": "redirect_hop_limit",
      "requested_url": "https://example.test/r0",
      "hops": [
        {"status": 302, "location": "/r1"},
        {"status": 302, "location": "/r2"},
        {"status": 302, "location": "/r3"},
        {"status": 302, "location": "/r4"},
        {"status": 302, "location": "/r5"},
        {"status": 302, "location": "/r6"},
        {"status": 302, "location": "/r7"},
        {"status": 302, "location": "/r8"},
        {"status": 302, "location": "/r9"},
        {"status": 302, "location": "/r10"},
        {"status": 302, "location": "/r11"}
      ],
      "expected_document_id": "https://example.test/r0",
      "expected_outcome": "reject_over_limit_retain_previous"
    }
  ],
  "admission_vectors": [
    {"source": "authored_local_fixture", "policy": "project_owned_cc0", "public_fetch": false, "robots": "allow", "expected": "allow_fixture_only"},
    {"source": "external_origin", "policy": null, "public_fetch": false, "robots": "allow", "expected": "deny_missing_policy"},
    {"source": "external_origin", "policy": "documented_allowlist", "public_fetch": false, "robots": "allow", "expected": "deny_public_fetch_disabled"},
    {"source": "redirect_target", "policy": "not_in_scope", "public_fetch": true, "robots": "allow", "expected": "deny_target"}
